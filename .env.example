# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
# In production these live in the Vercel project settings.

# Supabase — the system of record for every reply.
# Project Settings -> API. The service_role key bypasses row level security,
# so it is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — the immediate notification.
RESEND_API_KEY=

# Where replies land. Comma-separated for several recipients. While Resend is
# in test mode this MUST be the address on the Resend account, or nothing
# arrives.
RSVP_NOTIFY_TO=yeukaiweddingvowrenewal@gmail.com

# Optional. Unset -> Resend's test sender, and guest confirmation emails are
# skipped (the test sender can only deliver to the account address). Set this
# to an address on a domain verified in Resend and confirmations turn on with
# no code change, e.g. "Herald & Yeukai <rsvp@example.com>".
RESEND_FROM=

# Development only. The test sender onboarding@resend.dev is treated as
# unverified, because it can only deliver to the Resend account address. Set
# this to "true" alongside RESEND_FROM="... <onboarding@resend.dev>" to preview
# a guest confirmation locally — send it to the account address or it bounces.
# Never set this in production.
RESEND_ALLOW_TEST_SENDER=

# Optional. Set this in Vercel and the keep-alive cron route will reject any
# request that does not carry it; Vercel sends it automatically on scheduled
# runs. Leave unset and the route stays open, which is harmless.
CRON_SECRET=
